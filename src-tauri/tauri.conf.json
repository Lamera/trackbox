{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Trackbox",
  "version": "1.6.0",
  "identifier": "com.dme86.trackbox",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Trackbox",
        "width": 1800,
        "height": 1130,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "acceptFirstMouse": true,
        "visible": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: rbl: asset: http://rbl.localhost http://asset.localhost; media-src 'self' blob: rbl: asset: http://rbl.localhost http://asset.localhost; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; frame-src; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "DJ library manager and two-deck performance software",
    "longDescription": "Manage and analyze a DJ music library, export to compatible devices, and develop a two-deck DJ performance workflow.",
    "copyright": "Chris Le",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/rbxport.sdef": "rbxport.sdef"
      }
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "resources": {
      "windows/install-update-task.ps1": "install-update-task.ps1"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1NzM4N0E0RTUwMEE2RTMKUldUanBnRGxwSWR6eFgyT1A3NTV0SHRMU0JDVkpEeTY0MHhHc0x4RUpxNnNBQmdBZVpmUzJueVkK",
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
